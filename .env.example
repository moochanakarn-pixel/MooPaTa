# --- Database ---
# MySQL (tested against 8.x). Create the DB first: CREATE DATABASE moopata CHARACTER SET utf8mb4;
# Example below assumes a MySQL 8.4 instance running alongside another MySQL
# install on a non-default port (e.g. Windows service "MySQL80" on 3308) —
# adjust the port to whatever your instance actually listens on.
DATABASE_URL="mysql://root:PASSWORD@localhost:3308/moopata"

# --- App ---
# Public base URL of the app, no trailing slash. Used to build OAuth redirect URIs.
APP_BASE_URL="http://localhost:3000"

# 32-byte (64 hex char) key used to encrypt provider tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# 32-byte (64 hex char) key used to sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# --- Strava (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
# Must exactly match the "Authorization Callback Domain" set in your Strava API app,
# and the full URL must be APP_BASE_URL + /api/auth/strava/callback
STRAVA_REDIRECT_URI="http://localhost:3000/api/auth/strava/callback"

# --- Huawei Health Kit (pending approval, see README) ---
# Fill these in once your Health Kit app is approved on HUAWEI Developers.
HUAWEI_CLIENT_ID=""
HUAWEI_CLIENT_SECRET=""
HUAWEI_REDIRECT_URI="http://localhost:3000/api/auth/huawei/callback"
