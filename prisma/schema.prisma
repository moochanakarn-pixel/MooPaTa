generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// A person using MooPaTa. Identity is established by whichever provider
// they connect first (currently Strava, or email+password); more
// providers can link to the same user later.
model User {
  id            String     @id @default(cuid())
  name          String?
  avatarUrl     String?    @db.VarChar(512)
  unitSystem    UnitSystem @default(METRIC)
  monthlyGoalKm Float? // distance goal for the current calendar month, always stored in km
  createdAt     DateTime   @default(now())

  // Email+password login — optional, alongside (not instead of) Strava.
  // A Strava-only user has all of these null; a fresh email signup has
  // email+passwordHash but only gets emailVerifiedAt once they click the
  // link Resend sends (src/lib/email.ts) — login is refused until then
  // (see /api/auth/login), same gate whether the account started as an
  // email signup or an existing Strava user added a password from
  // Settings. failedLoginCount/lockedUntil are a simple brute-force guard
  // (password login, unlike Strava OAuth, is guessable) — reset on
  // success, incremented on mismatch, mirrors the atomic-claim style
  // src/app/api/cron/water-reminder/route.ts already uses.
  email            String?   @unique
  passwordHash     String?   @db.Text
  emailVerifiedAt  DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // Nutrition profile — all optional since most users won't fill this in
  // right away; src/lib/nutrition.ts treats an incomplete profile as "can't
  // compute targets yet" rather than guessing at missing inputs.
  weightKg          Float?
  heightCm          Float?
  age               Int?
  sex               Sex?
  activityLevel     ActivityLevel?
  nutritionGoal     NutritionGoal  @default(MAINTAIN)
  goalRateKgPerWeek Float? // only meaningful when nutritionGoal is LOSE/GAIN

  // Water-reminder schedule (src/app/api/cron/water-reminder) — a time
  // window plus how often within it, instead of the two fixed
  // afternoon/evening checkpoints the feature launched with. "HH:mm",
  // 24-hour, in the server's local time (same clock the rest of the app's
  // "today" boundaries already use).
  waterReminderStart       String    @default("09:00")
  waterReminderEnd         String    @default("22:00")
  waterReminderIntervalMin Int       @default(60)
  lastWaterReminderSentAt  DateTime?

  // Health-flag warnings (src/lib/health-flags.ts) — set by the user from
  // their own blood-test results, not diagnosed by the app. Purely
  // rule-based (a daily cholesterol total, a purine-keyword food-name
  // match), no AI involved.
  healthFlagHighCholesterol Boolean @default(false)
  healthFlagHighUricAcid    Boolean @default(false)

  // Post-workout whey reminder (src/app/api/cron/whey-reminder) — off by
  // default since it needs an activity to trigger from; a device still
  // needs its own push subscription (see PushSubscription) regardless of
  // this flag, same two-part opt-in as the water reminder.
  wheyReminderEnabled Boolean @default(false)

  // Progress photos (front/side/back) — a single current slot per angle,
  // not a history; re-uploading replaces the previous file. Stores a
  // relative path under the private uploads/ dir (see
  // src/app/api/progress-photo), never a public URL — the file is only
  // ever served back through that auth-gated route.
  frontPhotoPath String? @db.VarChar(255)
  sidePhotoPath  String? @db.VarChar(255)
  backPhotoPath  String? @db.VarChar(255)

  connections         ProviderConnection[]
  activities          Activity[]
  foods               Food[]
  foodLogs            FoodLog[]
  waterLogs           WaterLog[]
  supplements         Supplement[]
  supplementLogs      SupplementLog[]
  weightLogs          WeightLog[]
  bodyCompositionLogs BodyCompositionLog[]
  pushSubscriptions   PushSubscription[]
  authTokens          AuthToken[]
}

enum Provider {
  STRAVA
  MANUAL // hand-logged activity, e.g. football/badminton — Strava doesn't track these
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// A one-time-use link token emailed to a user (via Resend, see
// src/lib/email.ts) — for confirming a new email/password signup (or one
// added later from Settings) or for a password-reset request. Only the
// SHA-256 hash of the actual token is ever stored (src/lib/auth-tokens.ts)
// so a DB leak alone can never produce a usable link, same principle as
// SESSION_SECRET never being stored in plaintext anywhere reversible.
model AuthToken {
  id        String        @id @default(cuid())
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum UnitSystem {
  METRIC // km
  IMPERIAL // miles
}

enum Sex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY // little/no exercise
  LIGHT // 1-3 days/week
  MODERATE // 3-5 days/week
  ACTIVE // 6-7 days/week
  VERY_ACTIVE // hard daily exercise or physical job
}

enum NutritionGoal {
  LOSE
  MAINTAIN
  GAIN
}

// A reusable food "template", scoped to the user who created it — either by
// picking a suggestion from the built-in Thai food catalog (src/lib/thai-food-catalog.ts,
// not stored in the DB), scanning a barcode (via Open Food Facts, no API
// key/cost), or typing one in from scratch. Storing per-100g values (rather
// than per-serving) is what lets the same food be logged again later at a
// different portion size without re-entering its nutrition facts.
model Food {
  id                   String     @id @default(cuid())
  name                 String
  caloriesPer100g      Float
  proteinPer100g       Float
  carbPer100g          Float
  fatPer100g           Float
  // Optional — not every source has these (the built-in catalog doesn't),
  // so callers treat a missing value as "unknown" rather than zero.
  sugarPer100g         Float?
  sodiumMgPer100g      Float?
  cholesterolMgPer100g Float?
  fiberPer100g         Float?
  barcode              String?
  source               FoodSource @default(CUSTOM)
  createdAt            DateTime   @default(now())
  // A manual "โปรด" (favorite) star toggled from the personal library
  // (src/app/dashboard/food/library) — purely a display/sort affordance
  // for the user's own reference now; the food page's "เมนูที่กินบ่อย"
  // quick-pick suggestions are ranked by actual log frequency
  // (FoodLog count, computed server-side), not by this flag.
  // typicalGrams is the portion size a re-pick of this food prefills,
  // editable before saving.
  isFavorite           Boolean    @default(false)
  typicalGrams         Float      @default(100)
  // What a "grams" value on this food actually counts — the default "ก."
  // means grams like every food before this field existed; anything else
  // (e.g. "ชิ้น", "ที่", "ถ้วย") means grams/typicalGrams/FoodLog.grams for
  // this food are really a piece/serving count, not a weight. Keeps the
  // per-100 math in src/lib/food.ts unchanged — it only ever cares about the
  // ratio to 100, never what the 100 units of "grams" mean.
  unitLabel            String     @default("ก.")
  // Soft-delete — set when the user removes this food from their personal
  // library. Never hard-deleted: every FoodLog still points at this row
  // (see logs below) and computes its macros from it live, so actually
  // deleting the row would silently wipe that day's diary history along
  // with it. A non-null deletedAt just hides it from the library list and
  // from being picked/suggested again.
  deletedAt            DateTime?

  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs   FoodLog[]

  @@unique([userId, barcode])
  @@index([userId])
}

enum FoodSource {
  CATALOG // picked from the built-in Thai food catalog
  BARCODE // legacy — looked up from a scanned barcode via Open Food Facts (feature removed, kept so old rows still resolve)
  LABEL // typed in after reading a nutrition label photo
  CUSTOM // typed in from scratch
}

// One logged instance of eating a Food, at a specific portion size and time.
model FoodLog {
  id       String    @id @default(cuid())
  grams    Float
  loggedAt DateTime  @default(now())
  mealType MealType?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId String
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// One OAuth link between a User and an external fitness provider.
// Tokens are stored encrypted (see src/lib/crypto.ts) - never store them in plaintext.
model ProviderConnection {
  id                String    @id @default(cuid())
  provider          Provider
  providerAccountId String // Strava athlete id
  accessTokenEnc    String    @db.Text
  refreshTokenEnc   String    @db.Text
  expiresAt         DateTime
  scope             String?
  lastReconciledAt  DateTime? // last time we scanned full history for deletions (throttled, see sync-strava.ts)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Normalized activity shape shared across all providers so the rest of the
// app (dashboard, stats, future features) never has to branch on provider.
model Activity {
  id                 String    @id @default(cuid())
  provider           Provider
  providerActId      String // original activity id from the source provider
  type               String // e.g. Run, Ride, Walk, Hike, Swim
  name               String?
  startedAt          DateTime
  durationSec        Int
  distanceMeters     Float?
  elevationGainM     Float?
  elevHighM          Float?
  elevLowM           Float?
  avgHeartRate       Float?
  maxHeartRate       Float?
  avgSpeedMs         Float? // meters/second
  maxSpeedMs         Float? // meters/second
  avgCadence         Float?
  avgWatts           Float?
  kilojoules         Float?
  sufferScore        Int?
  calories           Float?
  kudosCount         Int?
  achievementCount   Int?
  prCount            Int?
  commentCount       Int?
  gearId             String?
  timezone           String?
  startLat           Float?
  startLng           Float?
  raw                Json // original provider payload, kept for anything not normalized above
  createdAt          DateTime  @default(now())
  // Set once the post-workout whey reminder has been sent for this activity
  // (src/app/api/cron/whey-reminder) — null means "not sent (or not
  // eligible) yet", not "no reminder wanted"; that's controlled separately
  // by User.wheyReminderEnabled. Prevents re-sending on every cron poll.
  wheyReminderSentAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  detail    ActivityDetail?
  exercises Exercise[]

  @@unique([provider, providerActId])
  @@index([userId, startedAt])
}

// One strength-training movement logged within a manually-entered activity
// (sets/reps/weight) — Strava-synced activities don't carry this kind of
// detail, so in practice this only ever attaches to provider=MANUAL
// activities, though nothing enforces that at the schema level.
model Exercise {
  id       String @id @default(cuid())
  name     String
  sets     Int
  reps     Int
  weightKg Float?
  order    Int // preserves the order entered in the form

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

// Richer per-activity data (splits, best efforts, laps, time-series streams)
// that Strava's summary list endpoint doesn't include — fetched lazily, only
// when a user opens that activity's detail page, since each fetch costs
// extra Strava API calls. Historical activities don't change, so once
// fetched it's cached here indefinitely rather than re-synced.
model ActivityDetail {
  id          String   @id @default(cuid())
  deviceName  String?
  splits      Json? // Strava's splits_metric: per-km pace/elevation
  bestEfforts Json? // named PR efforts, e.g. 5K, 1 mile
  laps        Json? // manual/auto laps: distance, time, pace, elevation per lap
  streams     Json? // { distance, altitude, velocity, heartrate, cadence }[] downsampled
  weather     Json? // { temperatureC, windKmh, weatherCode } from Open-Meteo, if GPS start coords exist
  fetchedAt   DateTime @default(now())

  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// One logged serving of water — just a timestamp and a volume, summed per
// day against the water target computed in src/lib/nutrition.ts.
model WaterLog {
  id       String   @id @default(cuid())
  ml       Int
  loggedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// One logged bodyweight reading, for the trend chart on the nutrition page.
// Logging a new entry also updates User.weightKg (see /api/weight/log) so
// BMR/TDEE always uses the most recently logged weight without a separate
// settings-page edit.
model WeightLog {
  id       String   @id @default(cuid())
  weightKg Float
  loggedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// One body-composition scan (InBody or similar bioelectrical-impedance
// device) — a periodic measurement, not an everyday log. The most recent
// entry is what src/lib/nutrition.ts uses to switch from the
// population-average Mifflin-St Jeor BMR formula to the more accurate
// Katch-McArdle one, which needs an actual lean-body-mass figure (derived
// from weightKg + bodyFatPercent here) rather than guessing one from
// weight/height/age/sex alone. Every field but weightKg is optional since
// not everyone has (or enters) the full InBody printout, and the app must
// keep working with the plain formula when this table is empty.
model BodyCompositionLog {
  id                   String   @id @default(cuid())
  loggedAt             DateTime @default(now())
  weightKg             Float
  // 0-100. Needed (together with weightKg) to derive lean body mass for
  // Katch-McArdle — a scan without this still gets recorded/shown, it just
  // doesn't change which BMR formula gets used.
  bodyFatPercent       Float?
  skeletalMuscleMassKg Float?
  visceralFatLevel     Int?
  // InBody's own on-device BMR estimate, if the printout/export includes
  // one — kept only for the user's own side-by-side comparison, never used
  // in our own calculations (ours is always computed fresh from
  // weightKg + bodyFatPercent above, so it stays consistent across users
  // regardless of which InBody model or firmware produced a given scan).
  inbodyReportedBmr    Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

// One browser/device's Web Push subscription — a user can have several
// (phone + desktop, or after reinstalling the PWA). Presence of a row is
// itself the "reminders on" state for that device; deleting it (via
// unsubscribe, or when a push to it starts failing — see src/lib/push.ts)
// is what turns reminders off.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @db.VarChar(1000)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint(length: 500)])
}

// A recurring supplement/vitamin the user wants a daily reminder for — no
// push notifications yet, just an in-app checklist (see SupplementLog).
model Supplement {
  id        String   @id @default(cuid())
  name      String
  timeLabel String? // free text, e.g. "เช้า", "ก่อนนอน", "20:00"
  note      String?  @db.VarChar(500) // e.g. "กินพร้อมมื้ออาหาร ไม่กินพร้อมแคลเซียม"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs   SupplementLog[]

  @@index([userId])
}

// Marks one supplement as taken at a point in time — existence of a row for
// today is what the checklist checkbox reflects.
model SupplementLog {
  id        String   @id @default(cuid())
  takenAt   DateTime @default(now())
  // Local calendar day ("YYYY-MM-DD", same format as src/lib/streak.ts's
  // localDateKey) that `takenAt` falls on, set explicitly by the toggle
  // route rather than derived in SQL. The unique constraint below is what
  // makes toggling atomic — the route always attempts a create first and
  // treats a unique-constraint conflict as "already taken today" — instead
  // of the old check-then-act pattern, which could create two rows for the
  // same day under a double-tap/concurrent request race.
  takenDate String   @db.VarChar(10)

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  @@unique([userId, supplementId, takenDate])
  @@index([userId, takenAt])
  @@index([supplementId, takenAt])
}
