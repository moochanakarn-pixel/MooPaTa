generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// A person using MooPaTa. Identity is established by whichever provider
// they connect first (currently Strava); more providers can link to the
// same user later.
model User {
  id             String       @id @default(cuid())
  name           String?
  avatarUrl      String?      @db.VarChar(512)
  unitSystem     UnitSystem   @default(METRIC)
  monthlyGoalKm  Float?       // distance goal for the current calendar month, always stored in km
  createdAt      DateTime     @default(now())

  connections     ProviderConnection[]
  activities      Activity[]
}

enum Provider {
  STRAVA
  HUAWEI_HEALTH
}

enum UnitSystem {
  METRIC // km
  IMPERIAL // miles
}

// One OAuth link between a User and an external fitness provider.
// Tokens are stored encrypted (see src/lib/crypto.ts) - never store them in plaintext.
model ProviderConnection {
  id                 String   @id @default(cuid())
  provider           Provider
  providerAccountId  String   // athlete id / huawei union id, etc.
  accessTokenEnc     String   @db.Text
  refreshTokenEnc    String   @db.Text
  expiresAt          DateTime
  scope              String?
  lastReconciledAt   DateTime? // last time we scanned full history for deletions (throttled, see sync-strava.ts)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Normalized activity shape shared across all providers so the rest of the
// app (dashboard, stats, future features) never has to branch on provider.
model Activity {
  id              String   @id @default(cuid())
  provider        Provider
  providerActId   String   // original activity id from the source provider
  type            String   // e.g. Run, Ride, Walk, Hike, Swim
  name            String?
  startedAt       DateTime
  durationSec     Int
  distanceMeters  Float?
  elevationGainM  Float?
  elevHighM       Float?
  elevLowM        Float?
  avgHeartRate    Float?
  maxHeartRate    Float?
  avgSpeedMs      Float?   // meters/second
  maxSpeedMs      Float?   // meters/second
  avgCadence      Float?
  avgWatts        Float?
  kilojoules      Float?
  sufferScore     Int?
  calories        Float?
  kudosCount      Int?
  achievementCount Int?
  prCount         Int?
  commentCount    Int?
  gearId          String?
  timezone        String?
  startLat        Float?
  startLng        Float?
  raw             Json     // original provider payload, kept for anything not normalized above
  createdAt       DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  detail ActivityDetail?

  @@unique([provider, providerActId])
  @@index([userId, startedAt])
}

// Richer per-activity data (splits, best efforts, laps, time-series streams)
// that Strava's summary list endpoint doesn't include — fetched lazily, only
// when a user opens that activity's detail page, since each fetch costs
// extra Strava API calls. Historical activities don't change, so once
// fetched it's cached here indefinitely rather than re-synced.
model ActivityDetail {
  id          String   @id @default(cuid())
  deviceName  String?
  splits      Json?    // Strava's splits_metric: per-km pace/elevation
  bestEfforts Json?    // named PR efforts, e.g. 5K, 1 mile
  laps        Json?    // manual/auto laps: distance, time, pace, elevation per lap
  streams     Json?    // { distance, altitude, velocity, heartrate, cadence }[] downsampled
  weather     Json?    // { temperatureC, windKmh, weatherCode } from Open-Meteo, if GPS start coords exist
  fetchedAt   DateTime @default(now())

  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}
